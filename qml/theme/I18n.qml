    function t(key, fallback) {
        if (language === "en")
            return fallback || key
        const selected = catalog[language]
        return selected && selected[key] ? selected[key] : (fallback || key)
    }

    function status(value) {
        const key = "status_" + String(value || "unknown")
            .toLowerCase().replace(/[^a-z0-9]+/g, "_")
        return t(key, value)
    }

    function reasonTitle(code, statusValue, fallback) {
        if (code === "Manual" && statusValue === "Disconnected")
            return t("reason_manual_title", fallback)
        if (code === "NoNetwork" || statusValue === "No Network")
            return t("reason_no_network_title", fallback)
        if (statusValue === "Connected")
            return t("reason_connected_title", fallback)
        if (statusValue === "Connecting")
            return t("reason_connecting_title", fallback)
        if (statusValue === "Disconnecting")
            return t("reason_disconnecting_title", fallback)
        if (statusValue === "Failed")
            return t("reason_failed_title", fallback)
        if (statusValue === "Unavailable")
            return t("reason_unavailable_title", fallback)
        if (statusValue === "Disconnected")
            return t("reason_ready_title", fallback)
        return fallback
    }

    function reason(code, statusValue, fallback) {
        if (code === "Manual" && statusValue === "Disconnected")
            return t("reason_manual", fallback)
        if (code === "NoNetwork" || statusValue === "No Network")
            return t("reason_no_network", fallback)
        if (statusValue === "Connected")
            return t("reason_connected", fallback)
        if (statusValue === "Connecting")
            return t("reason_connecting", fallback)
        if (statusValue === "Disconnecting")
            return t("reason_disconnecting", fallback)
        if (statusValue === "Failed")
            return t("reason_failed", fallback)
        if (statusValue === "Unavailable")
            return t("reason_unavailable", fallback)
        if (statusValue === "Disconnected")
            return t("reason_ready", fallback)
        return fallback
    }

    function activeCount(count) {
        return t("active_count", count + " active").replace("%1", count)
    }

    function autoMessage(value) {
        if (!value)
            return t(
                "restore_if_failed",
                "Settings are restored if no profile succeeds."
            )
        if (value === "Preparing connection tests…")
            return t("preparing_tests", value)
        if (value === "Selection cancelled.")
            return t("selection_cancelled", value)
        if (value === "No working profile was found.")
            return t("no_working_profile", value)
        if (value.indexOf("Testing ") === 0)
            return t("testing_profile", value).replace(
                "%1", value.substring(8)
            )
        if (value.indexOf("Selected ") === 0)
            return t("selected_profile", value).replace(
                "%1", value.substring(9)
            )
        return value
    }

    function autoProfile(value) {
        if (value === "Preparing test matrix")
            return t("preparing_matrix", value)
        if (value === "No verified profile")
            return t("no_verified_profile", value)
        return value
    }

    function activityCategory(value) {
        const key = "category_" + String(value || "system").toLowerCase()
        return t(key, String(value || "system").toUpperCase())
    }

    function activityText(value) {
        const keys = {
            "PyWarp opened": "event_opened",
            "Secure connection established": "event_connected",
            "Connection closed": "event_closed",
            "Connection action failed": "event_action_failed",
            "WARP could not complete an action": "event_warp_action_failed",
            "The new setting was accepted by Cloudflare WARP.": "event_setting_accepted",
            "The secure tunnel was stopped manually.": "reason_manual",
            "Connect to create a private route through Cloudflare.": "reason_ready"
        }
        return keys[value] ? t(keys[value], value) : value
    }

    function directionalText(value) {
        const text = String(value || "")
        return rtl && text ? "\u202B" + text + "\u202C" : text
    }
}
